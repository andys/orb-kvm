[Unit]
Description=Make the orb hostname resolvable
DefaultDependencies=no
After=local-fs.target systemd-remount-fs.service
Before=network-pre.target sysinit.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'h=$(hostname); grep -qw "$h" /etc/hosts || echo "127.0.1.1 $h" >> /etc/hosts'

[Install]
WantedBy=sysinit.target
