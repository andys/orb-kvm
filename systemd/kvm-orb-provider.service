# systemd user unit for the Amp orb provider backed by KVM.
#
#   mkdir -p ~/.config/kvm-orbs ~/.config/systemd/user
#   echo 'AMP_ORB_PROVIDER_TOKEN=aop_live_...' > ~/.config/kvm-orbs/provider.env
#   chmod 600 ~/.config/kvm-orbs/provider.env
#   cp systemd/kvm-orb-provider.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now kvm-orb-provider
#   sudo loginctl enable-linger $USER   # keep running without a login session
#
# Adjust ExecStart if amp or this repo live elsewhere.

[Unit]
Description=Amp orb provider (KVM/QEMU orbs)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/kvm-orbs/provider.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/amp orb provider %h/proj/orbsystem/dispatch.sh
Restart=always
RestartSec=5
# The VMs are daemonized QEMU processes in this unit's cgroup. Only stop the
# provider itself on restart, so running orbs keep running.
KillMode=process

[Install]
WantedBy=default.target
